      "PowerShell(Get-Content .env)",
      "PowerShell(Get-Content .env.local)",
      "PowerShell(Get-Content .env.development)",
      "PowerShell(Get-Content .env.development.local)",
      "PowerShell(Get-Content .env.test)",
      "PowerShell(Get-Content .env.test.local)",
      "PowerShell(Get-Content .env.production)",
      "PowerShell(Get-Content .env.production.local)",
      "PowerShell(Get-Content .env.staging)",
      "PowerShell(Get-Content .env.staging.local)",
      "PowerShell(gc .env)",
      "PowerShell(gc .env.local)",
      "PowerShell(cat .env)",
      "PowerShell(cat .env.local)",
      "PowerShell(type .env)",
      "PowerShell(type .env.local)",
      "PowerShell(Get-Content *credentials.json)",
      "PowerShell(Get-Content *.pem)",
      "PowerShell(Get-Content *.key)",
      "PowerShell(Get-Content *.p12)",
      "PowerShell(Get-Content *.pfx)",
      "PowerShell(Get-Content *id_rsa*)",
      "PowerShell(Get-Content *id_ed25519*)",
      "PowerShell(Get-Content *.serviceaccount.json)",
      "PowerShell(Get-Content *serviceAccount*.json)",
      "PowerShell(Get-Content *.aws/credentials)"
