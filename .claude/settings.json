      "Bash(type .env.development)",
      "Bash(type .env.development.local)",
      "Bash(type .env.test)",
      "Bash(type .env.test.local)",
      "Bash(type .env.production)",
      "Bash(type .env.production.local)",
      "Bash(type .env.staging)",
      "Bash(type .env.staging.local)",
      "Bash(more .env)",
      "Bash(more .env.local)",
      "Bash(less .env)",
      "Bash(less .env.local)",
      "Bash(head .env)",
      "Bash(head .env.local)",
      "Bash(tail .env)",
      "Bash(tail .env.local)",
      "Bash(cat *credentials.json)",
      "Bash(cat **/credentials.json)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Bash(cat *.p12)",
      "Bash(cat *.pfx)",
      "Bash(cat *id_rsa*)",
      "Bash(cat *id_ed25519*)",
      "Bash(cat *.serviceaccount.json)",
      "Bash(cat *serviceAccount*.json)",
      "Bash(cat *.aws/credentials)",
