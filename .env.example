# Copy to .env and fill in real values. Never commit .env.

# App
APP_SECRET=replace-me-with-a-long-random-string
APP_ENV=development

# LLM (local via Ollama; hosted provider keys only if that phase happens later)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=replace-me
OLLAMA_EMBED_MODEL=replace-me


# Supabase (hosted Cloud free-tier project — dev included, not the local CLI)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-me
# Server-only (FastAPI/worker/admin scripts) — never VITE_*, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Database (used by app/services/db.py + scripts/migrate.py — psycopg direct connection).
# Use the Supabase "Session pooler" connection string (Project Settings > Database),
# not the direct db.<ref>.supabase.co host — that host is IPv6-only and won't resolve
# on networks without IPv6 (seen on this dev machine's network).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:password@aws-0-REGION.pooler.supabase.com:5432/postgres

# Neo4j Aura Free (hosted graph — dev included, not local/container Neo4j — server only)
NEO4J_URI=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me

# Redis / jobs
REDIS_URL=redis://localhost:6379/0

# Optional observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Frontend (public — anon key only, never service_role)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me
VITE_API_URL=http://localhost:8000
---
