# Copy to .env and fill in real values. Never commit .env.

# App
APP_SECRET=replace-me-with-a-long-random-string
APP_ENV=development

# LLM (local via Ollama; hosted provider keys only if that phase happens later)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=replace-me
OLLAMA_EMBED_MODEL=replace-me
OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=replace-me

# Supabase (hosted Cloud free-tier project — dev included, not the local CLI)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-only

# Database (Supabase's hosted Postgres connection string, if needed beyond the client)
DATABASE_URL=postgresql://user:password@YOUR_PROJECT.supabase.co:5432/postgres

# Neo4j Aura Free (hosted graph — dev included, not local/container Neo4j — server only)
NEO4J_URI=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me

# Redis / jobs
REDIS_URL=redis://localhost:6379/0

# Optional observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Frontend (public — anon key only, never service_role)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me
VITE_API_URL=http://localhost:8000
---
